{
  "name": "happy",
  "version": "1.2.0",
  "description": "Mobile and Web client for your terminal",
  "author": "Kirill Dubovitskiy",
  "license": "MIT",
  "type": "module",
  "homepage": "https://happy.engineering",
  "bugs": "https://github.com/slopus/happy/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/slopus/happy"
  },
  "bin": {
    "happy": "./bin/happy.mjs"
  },
  "files": [
    "bin",
    "scripts",
    "tools/archives",
    "tools/licenses",
    "tools/cli",
    "tools/host-agent",
    "tools/server",
    "tools/webapp",
    "package.json"
  ],
  "scripts": {
    "bundle:server": "node scripts/bundle-server.cjs",
    "bundle:server:all": "node scripts/bundle-server.cjs --all-platforms",
    "bundle:webapp": "node scripts/bundle-webapp.cjs",
    "build": "pnpm run native:stage",
    "native:build": "node scripts/build-native-cli.cjs",
    "native:stage": "node scripts/build-native-cli.cjs --stage",
    "native:verify-staged": "node scripts/verify-native-cli-binaries.cjs",
    "host-agent:build": "node scripts/build-host-agent.cjs",
    "host-agent:stage": "node scripts/build-host-agent.cjs --stage",
    "host-agent:verify-staged": "node scripts/verify-host-agent-binaries.cjs",
    "test": "pnpm run rust:test",
    "rust:test": "cargo test --locked --manifest-path Cargo.toml",
    "cli:install": "node scripts/install-local.cjs",
    "prepublishOnly": "pnpm native:verify-staged && pnpm host-agent:verify-staged && pnpm test",
    "postinstall": "node scripts/unpack-tools.cjs"
  },
  "dependencies": {
    "tar": "^7.5.2"
  },
  "devDependencies": {
    "tsx": "^4.20.6"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "packageManager": "pnpm@10.11.0"
}
